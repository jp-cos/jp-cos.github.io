@prefix cs: <https://w3id.org/jp-cos/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix schema: <http://schema.org/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
cs:StageShape
  rdf:type sh:NodeShape;
  sh:property [
    skos:example "<ul><li>\"Stage 1\"@en</li><li>\"１段階\"@ja</li></ul>";
    sh:datatype rdf:langString;
    sh:description "Using language tags, Japanese and English name are shown. The meanings of language tags are as follows:<dl><dt>@ja</dt><dd>Japanese name (Kanji)</dd><dt>@en</dt><dd>English name</dd></dl>"@en, "また、言語コードを用いて、名称に加え、英語名称を示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>日本語名称（漢字表記）</dd><dt>@en</dt><dd>英語名称</dd></dl>"@ja;
    sh:languageIn [
      rdf:first "ja" "en";
      rdf:rest  rdf:nil[
        rdf:first "ja" "en";
        rdf:rest  rdf:nil
      ]
    ];
    sh:maxCount 2;
    sh:minCount 1;
    sh:name "Name"@en, "名称"@ja;
    sh:order 1;
    sh:path schema:name;
    sh:uniqueLang true
  ], [
    sh:datatype rdf:langString xsd:string;
    sh:maxCount 2 1;
    sh:minCount 1 1;
    sh:name "Name"@en, "名称"@ja "Descriotion"@en, "説明"@ja;
    sh:order 1 2;
    sh:path schema:name schema:description
  ], [
    skos:example "<ul><li>\"Stage 1\"@en</li><li>\"１段階\"@ja</li></ul>" "文部科学省. \"第４章 知的障害である児童生徒に対する教育を行う特別支援学校の各教科 第 1 節 知的障害者である児童生徒に対する教育を行う特別支援学校の各教科等の基本的な考え方 ５　段階の考え方\". 特別支援学校学習指導要領解説　各教科等変（小学部・中学部） 平成30年3月.　p.23-25. 参照日：2021-08-07.";
    sh:datatype rdf:langString xsd:string xsd:string;
    sh:description "Using language tags, Japanese and English name are shown. The meanings of language tags are as follows:<dl><dt>@ja</dt><dd>Japanese name (Kanji)</dd><dt>@en</dt><dd>English name</dd></dl>"@en, "また、言語コードを用いて、名称に加え、英語名称を示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>日本語名称（漢字表記）</dd><dt>@en</dt><dd>英語名称</dd></dl>"@ja "Refer to the official publication."@en, "文部科学省（文部省）が発行した文書についての情報。"@ja;
    sh:maxCount 2 1 1;
    sh:minCount 1 1 1;
    sh:name "Name"@en, "名称"@ja "Descriotion"@en, "説明"@ja "Reference"@en, "出典"@ja;
    sh:order 1 2 3;
    sh:path schema:name schema:description schema:citation
  ], [
    skos:example "<ul><li>\"Stage 1\"@en</li><li>\"１段階\"@ja</li></ul>" "文部科学省. \"第４章 知的障害である児童生徒に対する教育を行う特別支援学校の各教科 第 1 節 知的障害者である児童生徒に対する教育を行う特別支援学校の各教科等の基本的な考え方 ５　段階の考え方\". 特別支援学校学習指導要領解説　各教科等変（小学部・中学部） 平成30年3月.　p.23-25. 参照日：2021-08-07." <http://ja.dbpedia.org/resource/知的障害>;
    sh:minCount 1 1 1 1;
    sh:name "Name"@en, "名称"@ja "Descriotion"@en, "説明"@ja "Reference"@en, "出典"@ja "Related link(s)"@en, "関連リンク"@ja;
    sh:nodeKind sh:IRI;
    sh:order 1 2 3 4;
    sh:path schema:name schema:description schema:citation rdfs:seeAlso
  ], [
    skos:example "<ul><li>\"Stage 1\"@en</li><li>\"１段階\"@ja</li></ul>" "文部科学省. \"第４章 知的障害である児童生徒に対する教育を行う特別支援学校の各教科 第 1 節 知的障害者である児童生徒に対する教育を行う特別支援学校の各教科等の基本的な考え方 ５　段階の考え方\". 特別支援学校学習指導要領解説　各教科等変（小学部・中学部） 平成30年3月.　p.23-25. 参照日：2021-08-07." <http://ja.dbpedia.org/resource/知的障害> cs:disabilityCategory\/Intellectual;
    sh:class cs:DisabilityCategory;
    sh:maxCount 2 1 1 1;
    sh:minCount 1 1 1 1 1;
    sh:name "Name"@en, "名称"@ja "Descriotion"@en, "説明"@ja "Reference"@en, "出典"@ja "Related link(s)"@en, "関連リンク"@ja "Disability Category"@en, "障害分類"@ja;
    sh:order 1 2 3 4 5;
    sh:path schema:name schema:description schema:citation rdfs:seeAlso cs:disabilityCategory
  ], [
    skos:example "<ul><li>\"Stage 1\"@en</li><li>\"１段階\"@ja</li></ul>" "文部科学省. \"第４章 知的障害である児童生徒に対する教育を行う特別支援学校の各教科 第 1 節 知的障害者である児童生徒に対する教育を行う特別支援学校の各教科等の基本的な考え方 ５　段階の考え方\". 特別支援学校学習指導要領解説　各教科等変（小学部・中学部） 平成30年3月.　p.23-25. 参照日：2021-08-07." <http://ja.dbpedia.org/resource/知的障害> cs:disabilityCategory\/Intellectual cs:school\/ElementaryDeptSNES;
    sh:class cs:DisabilityCategory cs:School;
    sh:maxCount 2 1 1 1 1;
    sh:minCount 1 1 1 1 1 1;
    sh:name "Name"@en, "名称"@ja "Descriotion"@en, "説明"@ja "Reference"@en, "出典"@ja "Related link(s)"@en, "関連リンク"@ja "Disability Category"@en, "障害分類"@ja "Type of School"@en, "学校種別"@ja;
    sh:order 1 2 3 4 5 6;
    sh:path schema:name schema:description schema:citation rdfs:seeAlso cs:disabilityCategory cs:school
  ];
  sh:targetClass cs:Stage.
