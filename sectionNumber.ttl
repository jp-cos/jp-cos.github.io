@prefix cs: <https://w3id.org/jp-cos/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
cs:sectionNumber
  rdf:type rdf:Property;
  rdfs:domain cs:Item;
  rdfs:label "Section Number"@en, "節番号"@ja;
  rdfs:range rdf:Literal.
cs:ItemShape sh:property [
    skos:example "(イ)";
    sh:datatype xsd:string;
    sh:description "It is the section number in the course fo study text. It is created automatically by the program. Half-size katakana is converted to full-size katakana."@en, "学習指導要領テキスト中の節番号を表す。ないこともある。プログラムで自動作成。半角カタカナは全角カタカナに変換。"@ja;
    sh:maxCount 1;
    sh:name "Section Number"@en, "節番号"@ja;
    sh:order 13;
    sh:path cs:sectionNumber
  ].
