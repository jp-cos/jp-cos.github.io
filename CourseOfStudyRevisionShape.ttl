cs:CourseOfStudyRevisionShape
  rdf:type sh:NodeShape;
  sh:property [
    skos:example cs:period\/H29toH31;
    sh:class cs:Period;
    sh:description "It corresponds to the first digit of the course of study code."@en, "学習指導要領コードの1桁目に対応"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Issued Period"@en, "告示時期"@ja;
    sh:order 1;
    sh:path cs:issuedPeriod
  ], [
    skos:example cs:period\/H29toH31 "<ul><li>\"中学校学習指導要領 平成22年11月 一部改正\"@ja</li><li>\"Lower Secondary School Curriculum Guideline 2010-11 Notification of Partial Revision\"@en</li></ul>";
    sh:datatype rdf:langString;
    sh:description "It corresponds to the first digit of the course of study code."@en, "学習指導要領コードの1桁目に対応"@ja "If the revision is on a part of a guideline, the name of the revision will be assigned such as \"Partial revision in December 2003\". Using language tags, Japanese and English name are shown. The meanings of language tags are as follows:<dl><dt>@ja</dt><dd>Japanese name (Kanji)</dd><dt>@en</dt><dd>English name</dd></dl>"@en, "一部改正であれば、「平成15年12月 一部改正」のような表現となります。また、言語コードを用いて、名称に加え、英語名称を示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>日本語名称（漢字表記）</dd><dt>@en</dt><dd>英語名称</dd></dl>"@ja;
    sh:languageIn [
      rdf:first "ja" "en";
      rdf:rest  rdf:nil[
        rdf:first "ja" "en";
        rdf:rest  rdf:nil
      ]
    ];
    sh:maxCount 1 2;
    sh:minCount 1 1;
    sh:name "Issued Period"@en, "告示時期"@ja "Name of the revision"@en, "別バージョンの名称"@ja;
    sh:order 1 2;
    sh:path cs:issuedPeriod schema:name;
    sh:uniqueLang true
  ], [
    skos:example cs:period\/H29toH31 "<ul><li>\"中学校学習指導要領 平成22年11月 一部改正\"@ja</li><li>\"Lower Secondary School Curriculum Guideline 2010-11 Notification of Partial Revision\"@en</li></ul>" "<ul><li>\"『平成22年 文部科学省告示第百六十一号』（官報. 平成22年11月30日, 号外第250号, pp.90）\"@ja</li><li>\"\\\"Notification No. 161 in 2010 of the Ministry of Education, Culture, Sports, Science and Technology\\\" (Official Gazette, 2010-11-30, Extra Edition No. 250, pp.90)\"@en</li></ul>";
    sh:datatype rdf:langString rdf:langString;
    sh:description "It corresponds to the first digit of the course of study code."@en, "学習指導要領コードの1桁目に対応"@ja "If the revision is on a part of a guideline, the name of the revision will be assigned such as \"Partial revision in December 2003\". Using language tags, Japanese and English name are shown. The meanings of language tags are as follows:<dl><dt>@ja</dt><dd>Japanese name (Kanji)</dd><dt>@en</dt><dd>English name</dd></dl>"@en, "一部改正であれば、「平成15年12月 一部改正」のような表現となります。また、言語コードを用いて、名称に加え、英語名称を示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>日本語名称（漢字表記）</dd><dt>@en</dt><dd>英語名称</dd></dl>"@ja "Refer to the official announcement and its publication. Using language tags, Japanese and English names shown. The meanings of language tags are as follows: <dl><dt>@ja</dt><dd>Japanese name (Kanji)</dd><dt>@en</dt><dd>English name</dd></dl>"@en, "文部科学省（文部省）の告示タイトルおよび掲載された官報についての情報。また、言語コードを用いて、出典に加え、英語の出典を示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>日本語出典（漢字表記）</dd><dt>@en</dt><dd>英語出典</dd></dl>"@ja;
    sh:languageIn [
      rdf:first "ja" "en";
      rdf:rest  rdf:nil[
        rdf:first "ja" "en";
        rdf:rest  rdf:nil
      ]
    ] [
      rdf:first "ja" "en" "ja" "en";
      rdf:rest  rdf:nil[
        rdf:first "ja" "en";
        rdf:rest  rdf:nil
      ]  rdf:nil[
        rdf:first "ja" "en" "ja" "en";
        rdf:rest  rdf:nil[
        rdf:first "ja" "en";
        rdf:rest  rdf:nil
      ]  rdf:nil
      ]
    ];
    sh:maxCount 1 2 2;
    sh:minCount 1 1 1;
    sh:name "Issued Period"@en, "告示時期"@ja "Name of the revision"@en, "別バージョンの名称"@ja "Reference"@en, "出典"@ja;
    sh:order 1 2 3;
    sh:path cs:issuedPeriod schema:name schema:citation;
    sh:uniqueLang true true
  ], [
    skos:example cs:period\/H29toH31 "<ul><li>\"中学校学習指導要領 平成22年11月 一部改正\"@ja</li><li>\"Lower Secondary School Curriculum Guideline 2010-11 Notification of Partial Revision\"@en</li></ul>" "<ul><li>\"『平成22年 文部科学省告示第百六十一号』（官報. 平成22年11月30日, 号外第250号, pp.90）\"@ja</li><li>\"\\\"Notification No. 161 in 2010 of the Ministry of Education, Culture, Sports, Science and Technology\\\" (Official Gazette, 2010-11-30, Extra Edition No. 250, pp.90)\"@en</li></ul>" <http://www.mext.go.jp/a_menu/shotou/old-cs/1322235.htm>;
    sh:description "It corresponds to the first digit of the course of study code."@en, "学習指導要領コードの1桁目に対応"@ja "If the revision is on a part of a guideline, the name of the revision will be assigned such as \"Partial revision in December 2003\". Using language tags, Japanese and English name are shown. The meanings of language tags are as follows:<dl><dt>@ja</dt><dd>Japanese name (Kanji)</dd><dt>@en</dt><dd>English name</dd></dl>"@en, "一部改正であれば、「平成15年12月 一部改正」のような表現となります。また、言語コードを用いて、名称に加え、英語名称を示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>日本語名称（漢字表記）</dd><dt>@en</dt><dd>英語名称</dd></dl>"@ja "Refer to the official announcement and its publication. Using language tags, Japanese and English names shown. The meanings of language tags are as follows: <dl><dt>@ja</dt><dd>Japanese name (Kanji)</dd><dt>@en</dt><dd>English name</dd></dl>"@en, "文部科学省（文部省）の告示タイトルおよび掲載された官報についての情報。また、言語コードを用いて、出典に加え、英語の出典を示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>日本語出典（漢字表記）</dd><dt>@en</dt><dd>英語出典</dd></dl>"@ja "Repeatable. Links to the fulltext(s), such as MEXT website and <a href=\"http://www.nier.go.jp/guideline/\">NIER Curriculum Guidelines Database</a>."@en, "繰り返しあり。本文へのリンク。文部科学省ウェブページか<a href=\"http://www.nier.go.jp/guideline/\">国立教育政策研究所学習指導要領データベース</a>へのリンク。"@ja;
    sh:name "Issued Period"@en, "告示時期"@ja "Name of the revision"@en, "別バージョンの名称"@ja "Reference"@en, "出典"@ja "Fulltext URL"@en, "本文URL"@ja;
    sh:nodeKind sh:IRI;
    sh:order 1 2 3 4;
    sh:path cs:issuedPeriod schema:name schema:citation schema:url
  ], [
    skos:example cs:period\/H29toH31 "<ul><li>\"中学校学習指導要領 平成22年11月 一部改正\"@ja</li><li>\"Lower Secondary School Curriculum Guideline 2010-11 Notification of Partial Revision\"@en</li></ul>" "<ul><li>\"『平成22年 文部科学省告示第百六十一号』（官報. 平成22年11月30日, 号外第250号, pp.90）\"@ja</li><li>\"\\\"Notification No. 161 in 2010 of the Ministry of Education, Culture, Sports, Science and Technology\\\" (Official Gazette, 2010-11-30, Extra Edition No. 250, pp.90)\"@en</li></ul>" <http://www.mext.go.jp/a_menu/shotou/old-cs/1322235.htm> <http://id.ndl.go.jp/jpno/89034331>;
    sh:description "It corresponds to the first digit of the course of study code."@en, "学習指導要領コードの1桁目に対応"@ja "If the revision is on a part of a guideline, the name of the revision will be assigned such as \"Partial revision in December 2003\". Using language tags, Japanese and English name are shown. The meanings of language tags are as follows:<dl><dt>@ja</dt><dd>Japanese name (Kanji)</dd><dt>@en</dt><dd>English name</dd></dl>"@en, "一部改正であれば、「平成15年12月 一部改正」のような表現となります。また、言語コードを用いて、名称に加え、英語名称を示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>日本語名称（漢字表記）</dd><dt>@en</dt><dd>英語名称</dd></dl>"@ja "Refer to the official announcement and its publication. Using language tags, Japanese and English names shown. The meanings of language tags are as follows: <dl><dt>@ja</dt><dd>Japanese name (Kanji)</dd><dt>@en</dt><dd>English name</dd></dl>"@en, "文部科学省（文部省）の告示タイトルおよび掲載された官報についての情報。また、言語コードを用いて、出典に加え、英語の出典を示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>日本語出典（漢字表記）</dd><dt>@en</dt><dd>英語出典</dd></dl>"@ja "Repeatable. Links to the fulltext(s), such as MEXT website and <a href=\"http://www.nier.go.jp/guideline/\">NIER Curriculum Guidelines Database</a>."@en, "繰り返しあり。本文へのリンク。文部科学省ウェブページか<a href=\"http://www.nier.go.jp/guideline/\">国立教育政策研究所学習指導要領データベース</a>へのリンク。"@ja "Repeatable. Links to <a href=\"http://iss.ndl.go.jp/\">NDL Search</a> and <a href=\"https://ci.nii.ac.jp/books/\">CiNii Books</a>."@en, "繰り返しあり。<a href=\"http://iss.ndl.go.jp/\">国立国会図書館サーチ</a>、<a href=\"https://ci.nii.ac.jp/books/\">CiNii Books</a>へのリンク。"@ja;
    sh:name "Issued Period"@en, "告示時期"@ja "Name of the revision"@en, "別バージョンの名称"@ja "Reference"@en, "出典"@ja "Fulltext URL"@en, "本文URL"@ja "Related links"@en, "関連リンク"@ja;
    sh:nodeKind sh:IRI sh:IRI;
