@prefix cs: <https://w3id.org/jp-cos/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix schema: <http://schema.org/>.
@prefix qb: <http://purl.org/linked-data/cube#>.
@prefix bf: <http://id.loc.gov/ontologies/bibframe/>.
cs:ItemShape
  rdf:type sh:NodeShape;
  sh:property [
    skos:example "83H1203111200000";
    sh:datatype xsd:string;
    sh:description "The value of the \"Course of Study Code\" column of the original data."@en, "元データの「学習指導要領コード」列の値。"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Code of Course of Study Item"@en, "学習指導要領コード"@ja;
    sh:order 1;
    sh:path dct:identifier
  ], [
    skos:example "'''(イ) 語と語の連結による音の変化'''";
    sh:datatype xsd:string;
    sh:description "The value of the \"Text of Course of Study\" column of the original data."@en, "元データの「学習指導要領テキスト」列の値。"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Description of Course Of Study Item"@en, "学習指導要領テキスト"@ja;
    sh:order 2;
    sh:path schema:description
  ], [
    skos:example "第1章 / 第2章 / 第9節 / 第2 / 英語 / 2 / 〔知識及び技能〕 / (1) / ア / (イ)";
    sh:datatype xsd:string;
    sh:description "It is the section number hierarchy in the course fo study text. It is created automatically by the program. Half-size katakana is converted to full-size katakana."@en, "学習指導要領テキスト中の節番号の全階層分を表す。プログラムで自動作成。半角カタカナは全角カタカナに変換。"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Hierarchical Section Numbers"@en, "節番号（階層）"@ja;
    sh:order 3;
    sh:path cs:sectionNumberHierarchy
  ], [
    skos:example <https://www.mext.go.jp/component/a_menu/education/micro_detail/__icsFiles/afieldfile/2019/03/18/1387017_001.pdf#page=25>;
    sh:description "Link to the corresponding Course of Study Commentary with this item."@en, "対応する学習指導要領解説へのリンク"@ja;
    sh:maxCount 1;
    sh:name "Commentary Page"@en, "学習指導要領解説へのリンク"@ja;
    sh:nodeKind sh:IRI;
    sh:order 4;
    sh:path cs:commentaryPage
  ], [
    skos:example <cs:school/LowerSecondary>;
    sh:class cs:School;
    sh:description "It corresponds to the second digit of the course of study code."@en, "学習指導要領コードの2桁目に対応"@ja;
    sh:maxCount 2;
    sh:minCount 1;
    sh:name "Type of School"@en, "学校種別"@ja;
    sh:order 5;
    sh:path cs:school
  ], [
    skos:example <cs:disabilityCategory/Intellectual>;
    sh:class cs:DisabilityCategory;
    sh:description "It corresponds to the second digit of the course of study code."@en, "学習指導要領コードの2桁目に対応"@ja;
    sh:name "Disability Category"@en, "障害分類"@ja;
    sh:order 6;
    sh:path cs:disabilityCategory
  ], [
    skos:example cs:LowerSecondary\/2017\/外国語;
    sh:class cs:SubjectArea;
    sh:description "It corresponds to the 3rd digit of the course of study code."@en, "元データの「教科等」列の値。学習指導要領コードの3桁目に対応"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Subject Area"@en, "教科等"@ja;
    sh:order 7;
    sh:path cs:subjectArea
  ], [
    skos:example cs:LowerSecondary\/2017\/外国語\/英語;
    sh:class cs:Subject;
    sh:description "It corresponds to the 4th digit of the course of study code."@en, "学習指導要領コードの4桁目に対応"@ja;
    sh:maxCount 1;
    sh:name "Subject"@en, "分野・科目・分類"@ja;
    sh:order 8;
    sh:path cs:subject
  ], [
    skos:example "1,2";
    sh:datatype xsd:integer;
    sh:description "It corresponds to the 6th digit of the course of study code."@en, "学習指導要領コードの6桁目に対応"@ja;
    sh:name "Grade"@en, "学年"@ja;
    sh:order 9;
    sh:path cs:grade
  ], [
    skos:example cs:stage\/UpperSecondaryDeptSNES-Intellectual\/1;
    sh:class cs:Stage;
    sh:description "It corresponds to the 6th digit of the course of study code."@en, "学習指導要領コードの6桁目に対応"@ja;
    sh:name "Stage"@en, "段階"@ja;
    sh:order 10;
    sh:path cs:stage
  ], [
    skos:example "目標及び内容（大項目）";
    sh:datatype xsd:string;
    sh:description "It corresponds to the 5th digit of the course of study code."@en, "学習指導要領コードの5桁目に対応"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Category"@en, "大項目"@ja;
    sh:order 11;
    sh:path cs:category
  ], [
    skos:example "内容";
    sh:datatype xsd:string;
    sh:description "It corresponds to the 7th digit of the course of study code."@en, "学習指導要領コードの7桁目に対応"@ja;
    sh:maxCount 1;
    sh:name "Sub Category"@en, "項目"@ja;
    sh:order 12;
    sh:path cs:subCategory
  ], [
    skos:example "(イ)";
    sh:datatype xsd:string;
    sh:description "It is the section number in the course fo study text. It is created automatically by the program. Half-size katakana is converted to full-size katakana."@en, "学習指導要領テキスト中の節番号を表す。ないこともある。プログラムで自動作成。半角カタカナは全角カタカナに変換。"@ja;
    sh:maxCount 1;
    sh:name "Section Number"@en, "節番号"@ja;
    sh:order 13;
    sh:path cs:sectionNumber
  ], [
    skos:example "''語と語の連結による音の変化'''";
    sh:datatype xsd:string;
    sh:description "It is text without section number in the course fo study text. It is created automatically by the program. Half-size katakana is converted to full-size katakana."@en, "学習指導要領テキスト中の節番号を除いたテキスト。プログラムで自動作成。半角カタカナは全角カタカナに変換。"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Text"@en, "テキスト"@ja;
    sh:order 14;
    sh:path cs:sectionText
  ], [
    skos:example cs:8GH12a4222140000;
    sh:class cs:Item;
    sh:description "Child of the cource of study item. It is created automatically by the program using the regularity of the course of study code."@en, "子供の学習指導要領細目を表す。学習指導要領コードの規則性を利用してプログラムで自動作成。"@ja;
    sh:name "Child"@en, "子"@ja;
    sh:order 15;
    sh:path schema:hasPart
  ], [
    sh:description "Basic items of the Course of Study. Created from the Commentary on the Course of Study and related sources. A  Basic item of the Course of Study consists of a blank node, which has two properties <code>rdf:value</code> and <code>dct:provenance</code>."@en, "当該学習指導要領細目の基礎となる細目。学習指導要領解説などから作成する。<code>rdf:value</code>, <code>dct:provenance</code>の2つの項番用プロパティを持つ。"@ja;
    sh:name "Basic Course of Study Item"@en, "基礎の細目"@ja;
    sh:node cs:StructuredItemShape;
    sh:nodeKind sh:BlankNode;
    sh:order 16;
    sh:path cs:basicItem
  ], [
    sh:description "Advanced items of the Course of Study. Created from the Commentary on the Course of Study and related sources. A  Advanced item of the Course of Study consists of a blank node, which has two properties <code>rdf:value</code> and <code>dct:provenance</code>."@en, "当該学習指導要領細目の応用となる細目。学習指導要領解説などから作成する。<code>rdf:value</code>, <code>dct:provenance</code>の2つの項番用プロパティを持つ。"@ja;
    sh:name "Advanced Course of Study Item"@en, "応用の細目"@ja;
    sh:node cs:StructuredItemShape;
    sh:nodeKind sh:BlankNode;
    sh:order 17;
    sh:path cs:advancedItem
  ], [
    sh:class cs:Item;
    sh:description "Course Of Study Items referenced in the text"@en, "テキスト中に参照された他の学習指導要領細目"@ja;
    sh:name "Reference To Other Items"@en, "他の細目への参照"@ja;
    sh:order 18;
    sh:path schema:citation
  ], [
    skos:example cs:period\/H29toH31;
    sh:class cs:Period;
    sh:description "It corresponds to the first digit of the course of study code."@en, "学習指導要領コードの1桁目に対応"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Issued Period"@en, "告示時期"@ja;
    sh:order 19;
    sh:path cs:issuedPeriod
  ], [
    skos:example cs:LowerSecondary\/2017;
    sh:class cs:CourseOfStudy;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Course Of Study"@en, "学習指導要領"@ja;
    sh:order 20;
    sh:path cs:courseOfStudy
  ], [
    skos:example cs:LowerSecondary\/2017\/2017;
    sh:class cs:CourseOfStudyRevision;
    sh:description "Repeatable. It corresponds to the course of study revision."@en, "複数の改正がある場合、改正の件数分、繰り返される。"@ja;
    sh:minCount 1;
    sh:name "Course Of Study Revision"@en, "学習指導要領（一部改正情報）"@ja;
    sh:order 21;
    sh:path cs:courseOfStudyRevision
  ], [
    skos:example "一部改正なし";
    sh:datatype xsd:string;
    sh:description "It corresponds to the 16th digit of the course of study code."@en, "学習指導要領コードの16桁目に対応"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Edition of Course Of Study Item"@en, "改正情報"@ja;
    sh:order 22;
    sh:path schema:edition
  ], [
    skos:example cs:83V11;
    sh:class cs:Dataset;
    sh:minCount 1;
    sh:name "Source"@en, "出典"@ja;
    sh:order 23;
    sh:path dct:source
  ], [
    sh:description "Repeatable. The value of the \"No\" column of the original data. A item number information consists of a blank node, which has two properties <code>rdf:value</code> and <code>dct:source</code>."@en, "元データの「No」列の値。データセットの数だけ繰り返される。<code>rdf:value</code>, <code>dct:source</code>の2つの項番用プロパティを持つ。"@ja;
    sh:minCount 1;
    sh:name "Item Number"@en, "項番"@ja;
    sh:node cs:NumberShape;
    sh:nodeKind sh:BlankNode;
    sh:order 24;
    sh:path qb:order
  ], [
    skos:example "A8A3UHA1A2A0A3A1A1A1A2A0A0A0A0A0";
    sh:datatype xsd:string;
    sh:description "It is assigned \"A\" for numbers, L for lowercase letters, and U for uppercase letters to make course of study code easier to handle in Excel filters and pivot tables."@en, "学習指導要領コードをExcelのフィルタやピボットテーブルで扱いやすいように、数字であればAを、小文字であればLを、大文字であればUを付与したコード。"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Fcode of Course of Study"@en, "F学習指導要領コード"@ja;
    sh:order 25;
    sh:path cs:fcode
  ], [
    skos:example "<ul><li>'''コード表：86V11におけるこの学習指導要領の細目の学習指導要領コードの第6桁は「0」となっているが、正しくは「e」であると判断し、URIや関連するプロパティ値（学習指導要領コードや段階など）もそれに合わせるように変更した。'''@ja</li><li>'''The sixth digit of the original course of study code in code table 86V11 is \"0\", but the correct value is \"e\". The URI and related property values (course of study code, stage, etc.) were changed to match.'''@en</li></ul>";
    sh:datatype rdf:langString;
    sh:description "Using language tags, this property represents an original note and English note. Language codes are as follows:<dl><dt>@ja</dt><dd>Japanese note</dd><dt>@en</dt><dd>English note</dd></dl>"@en, "言語コードを用いて、備考を示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>日本語の備考</dd><dt>@en</dt><dd>英語の備考</dd></dl>"@ja;
    sh:languageIn [
      rdf:first "ja";
      rdf:rest [
        rdf:first "en";
        rdf:rest rdf:nil
      ]
    ];
    sh:name "Note"@en, "備考"@ja;
    sh:order 26;
    sh:path bf:note;
    sh:uniqueLang true
  ];
  sh:targetClass cs:Item.
