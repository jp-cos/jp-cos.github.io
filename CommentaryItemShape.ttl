@prefix cs: <https://w3id.org/jp-cos/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix schema: <http://schema.org/>.
@prefix qb: <http://purl.org/linked-data/cube#>.
cs:CommentaryItemShape
  rdf:type sh:NodeShape;
  sh:property [
    skos:example "1000031";
    sh:datatype xsd:string;
    sh:description "IDは数字7桁（独自のID）。"@ja, "The ID is a 7-digit number. The ID is an original identifier."@en;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "ID"@ja, "ID"@en;
    sh:order 1;
    sh:path dct:identifier
  ], [
    skos:example "\"　本内容は，第３学年「Ａ (1) 物と重さ」の学習を踏まえて，「粒子」についての基本的な概念等を柱とした内容のうちの「粒子の保存性」に関わるものであり，第６学年「Ａ (2) 水溶液の性質」の学習につながるものである。\"";
    sh:datatype xsd:string;
    sh:description "The value of the \"Text of  Commentary on the Course of Study\"."@en, "元データの「学習指導要領解説」の内容。"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Description"@en, "テキスト"@ja;
    sh:order 2;
    sh:path schema:description
  ], [
    skos:example cs:8260253110000000;
    sh:class cs:Item;
    sh:description "The Course of Study item addressed in this commentary"@en, "本解説で対象としている学習指導要領の細目"@ja;
    sh:name "The target Course of Study item"@en, "対象となる学習指導要領細目"@ja;
    sh:order 3;
    sh:path schema:about
  ], [
    skos:example cs:8260233110000000;
    sh:description "The Course of Study items referenced in this commentary"@en, "本解説で参照した学習指導要領の細目"@ja;
    sh:name "The referenced Course of Study item"@en, "参照した学習指導要領細目"@ja;
    sh:order 4;
    sh:path schema:citation
  ], [
    skos:example cs:commentary\/1000400;
    sh:class cs:CommentaryItem;
    sh:description "Child of the item."@en, "子供の細目を表す。"@ja;
    sh:name "Child"@en, "子"@ja;
    sh:order 5;
    sh:path schema:hasPart
  ], [
    skos:example <https://www.mext.go.jp/content/20211020-mxt_kyoiku02-100002607_05.pdf#page=68>;
    sh:description "Link to the corresponding Course of Study Commentary with this item."@en, "対応する学習指導要領解説へのリンク"@ja;
    sh:maxCount 1;
    sh:name "Commentary Page"@en, "学習指導要領解説へのリンク"@ja;
    sh:nodeKind sh:IRI;
    sh:order 6;
    sh:path cs:commentaryPage
  ], [
    skos:example "(1) 物の溶け方";
    sh:datatype xsd:string;
    sh:description "When an item represents a section title, it denotes the same content as the “Description.”"@en, "細目が節タイトルを表している場合は「テキスト」と同内容を表す。"@ja;
    sh:maxCount 1;
    sh:name "Section Title"@en, "節タイトル"@ja;
    sh:order 7;
    sh:path dct:title
  ], [
    skos:example "(1)";
    sh:datatype xsd:string;
    sh:description "Abbreviated section title, intended for use in breadcrumbs and similar contexts."@en, "「節タイトル」の短縮版。パンくずリストなどの利用を想定。"@ja;
    sh:maxCount 1;
    sh:name "Abbreviated title"@en, "短縮タイトル"@ja;
    sh:order 8;
    sh:path dct:alternative
  ], [
    skos:example "1";
    sh:datatype xsd:integer;
    sh:description "This is used in the order of the listings."@en, "表示順を決める場合などで利用"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Listing order of the item"@en, "順番"@ja;
    sh:order 9;
    sh:path qb:order
  ];
  sh:targetClass cs:CommentaryItem.
