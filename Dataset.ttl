cs:CourseOfStudyRevisionShape sh:property [
    skos:example cs:82V11;
    sh:class cs:Dataset;
    sh:name "Dataset"@en, "データセット"@ja;
    sh:order 13;
    sh:path cs:dataset
  ].
cs:CourseOfStudyShape sh:property [
    skos:example cs:82V11;
    sh:class cs:Dataset;
    sh:name "Dataset"@en, "データセット"@ja;
    sh:order 8;
    sh:path cs:dataset
  ].
cs:DatasetShape sh:targetClass cs:Dataset.
cs:ItemShape sh:property [
    skos:example cs:83V11;
    sh:class cs:Dataset;
    sh:minCount 1;
    sh:name "Source"@en, "出典"@ja;
    sh:order 23;
    sh:path dct:source
  ].
cs:NumberShape sh:property [
    skos:example cs:82V11;
    sh:class cs:Dataset;
    sh:name "Source"@en, "出典"@ja;
    sh:order 2;
    sh:path dct:source
  ].
cs:school rdfs:domain cs:Dataset.
