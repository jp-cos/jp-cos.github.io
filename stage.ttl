@prefix cs: <https://w3id.org/jp-cos/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
cs:stage
  rdf:type rdf:Property;
  rdfs:domain cs:Item;
  rdfs:label "Stage"@en, "段階"@ja;
  rdfs:range cs:Stage.
cs:ItemShape sh:property [
    skos:example cs:stage\/UpperSecondaryDeptSNES-Intellectual\/1;
    sh:class cs:Stage;
    sh:description "It corresponds to the 6th digit of the course of study code."@en, "学習指導要領コードの6桁目に対応"@ja;
    sh:name "Stage"@en, "段階"@ja;
    sh:order 10;
    sh:path cs:stage
  ].
