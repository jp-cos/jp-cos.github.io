@prefix cs: <https://w3id.org/jp-cos/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
cs:hasSubjectArea
  rdf:type rdf:Property;
  rdfs:domain cs:CourseOfStudy;
  rdfs:label "has a subject area"@en, "教科がある"@ja;
  rdfs:range cs:SubjectArea.
cs:CourseOfStudyShape sh:property [
    skos:example cs:Elementary\/2017\/国語;
    sh:class cs:SubjectArea;
    sh:minCount 1;
    sh:name "has a subject area"@en, "教科がある"@ja;
    sh:order 9;
    sh:path cs:hasSubjectArea
  ].
