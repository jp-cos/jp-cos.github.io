cs:LowerSecondary\/1998\/2006 rdf:type cs:CourseOfStudyRevision.
cs:LowerSecondary\/1998\/2007 rdf:type cs:CourseOfStudyRevision.
cs:LowerSecondary\/2008\/2008 rdf:type cs:CourseOfStudyRevision.
cs:LowerSecondary\/2008\/2010 rdf:type cs:CourseOfStudyRevision.
cs:LowerSecondary\/2008\/2015 rdf:type cs:CourseOfStudyRevision.
cs:SubjectAreaShape sh:property [
    skos:example cs:LowerSecondary\/2017\/2017;
    sh:class cs:CourseOfStudyRevision;
    sh:description "Repeatable. It corresponds to the revisions of the course of study."@en, "複数の改正がある場合、改正の件数分、繰り返される。"@ja;
    sh:minCount 1;
    sh:name "Course Of Study Revision"@en, "学習指導要領（一部改正情報）"@ja;
    sh:order 1;
    sh:path cs:courseOfStudyRevision
  ].
cs:SubjectShape sh:property [
    skos:example cs:LowerSecondary\/2017\/2017;
    sh:class cs:CourseOfStudyRevision;
    sh:description "Repeatable. It corresponds to the revisions of the course of study."@en, "複数の改正がある場合、改正の件数分、繰り返される。"@ja;
    sh:minCount 1;
    sh:name "Course Of Study Revision"@en, "学習指導要領（一部改正情報）"@ja;
    sh:order 1;
    sh:path cs:courseOfStudyRevision
  ].
