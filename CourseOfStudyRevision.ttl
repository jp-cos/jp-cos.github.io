@prefix cs: <https://w3id.org/jp-cos/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix dct: <http://purl.org/dc/terms/>.
cs:CourseOfStudyRevision
  rdf:type rdfs:Class;
  rdfs:comment "It represents course of study revision class. It is used in cases where some revisions are made during the 10-year period.URIs for the resources are represented as the following forms:<br><code>https://w3id.org/jp-cos/<var>type of school</var>/<var>date published of the first version</var>/<var>date published</var></code>"@en, "一部改正された学習指導要領を表すクラス。10年の間に一部改正が行われた場合などに利用。このリソースは次のようなURIにより表現されます。<br><code>https://w3id.org/jp-cos/<var>学校種別</var>/<var>初版の告示年</var>/<var>告示年（改正年）</var></code>"@ja;
  rdfs:label "Course of Study Revision"@en, "学習指導要領の別バージョン"@ja.
cs:CourseOfStudyRevisionShape sh:targetClass cs:CourseOfStudyRevision.
cs:CourseOfStudyShape sh:property [
    skos:example cs:Elementary\/2017\/2017;
    sh:class cs:CourseOfStudyRevision;
    sh:description "Repeatable. It corresponds to the course of study revision."@en, "複数の改正がある場合、改正の件数分、繰り返される。"@ja;
    sh:minCount 1;
    sh:name "Other versions"@en, "別バージョン"@ja;
    sh:order 7;
    sh:path dct:hasVersion
  ].
cs:Elementary\/1989\/1989 rdf:type cs:CourseOfStudyRevision.
cs:Elementary\/1998\/1998 rdf:type cs:CourseOfStudyRevision.
cs:Elementary\/1998\/2003 rdf:type cs:CourseOfStudyRevision.
cs:Elementary\/1998\/2007 rdf:type cs:CourseOfStudyRevision.
cs:Elementary\/2008\/2008 rdf:type cs:CourseOfStudyRevision.
cs:Elementary\/2008\/2015 rdf:type cs:CourseOfStudyRevision.
cs:ElementaryAndLowerSecondaryDeptSNES\/2009\/2009 rdf:type cs:CourseOfStudyRevision.
cs:ElementaryAndLowerSecondaryDeptSNES\/2009\/2015 rdf:type cs:CourseOfStudyRevision.
cs:ElementaryAndLowerSecondaryDeptSNES\/2017\/2017 rdf:type cs:CourseOfStudyRevision.
cs:ItemShape sh:property [
    skos:example cs:LowerSecondary\/2017\/2017;
    sh:class cs:CourseOfStudyRevision;
    sh:description "Repeatable. It corresponds to the course of study revision."@en, "複数の改正がある場合、改正の件数分、繰り返される。"@ja;
    sh:minCount 1;
    sh:name "Course Of Study Revision"@en, "学習指導要領（一部改正情報）"@ja;
    sh:order 21;
    sh:path cs:courseOfStudyRevision
  ].
cs:Kindergarten\/2008\/2008 rdf:type cs:CourseOfStudyRevision.
cs:Kindergarten\/2017\/2017 rdf:type cs:CourseOfStudyRevision.
cs:KindergartenDeptSNES\/2009\/2009 rdf:type cs:CourseOfStudyRevision.
cs:KindergartenDeptSNES\/2017\/2017 rdf:type cs:CourseOfStudyRevision.
cs:LowerSecondary\/1989\/1989 rdf:type cs:CourseOfStudyRevision.
cs:LowerSecondary\/1998\/1998 rdf:type cs:CourseOfStudyRevision.
