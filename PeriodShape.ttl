@prefix cs: <https://w3id.org/jp-cos/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix schema: <http://schema.org/>.
cs:PeriodShape
  rdf:type sh:NodeShape;
  sh:property [
    skos:example "<ul><li>\"平成29～31年　告示\"@ja</li><li>\"Published from 2017 to 2019\"@en</li></ul>";
    sh:datatype rdf:langString;
    sh:description "Using language tags, Japanese and English name are shown. The meanings of language tags are as follows:<dl><dt>@ja</dt><dd>Japanese name (Kanji)</dd><dt>@en</dt><dd>English name</dd></dl>"@en, "言語コードを用いて、名称に加え、英語名称を示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>日本語名称（漢字表記）</dd><dt>@en</dt><dd>英語名称</dd></dl>"@ja;
    sh:languageIn [
      rdf:first "ja";
      rdf:rest [
        rdf:first "en";
        rdf:rest rdf:nil
      ]
    ];
    sh:maxCount 2;
    sh:minCount 1;
    sh:name "Name"@en, "名称"@ja;
    sh:order 1;
    sh:path schema:name;
    sh:uniqueLang true
  ], [
    skos:example "2017-01-01";
    sh:datatype xsd:date;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Start Date"@en, "時期開始日"@ja;
    sh:order 2;
    sh:path schema:startDate
  ], [
    skos:example "2019-12-31";
    sh:datatype xsd:date;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "End Date"@en, "時期終了日"@ja;
    sh:order 3;
    sh:path schema:endDate
  ], [
    skos:example "8";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "First Digit Code of Course of Study Item"@en, "学習指導要領コード1桁目"@ja;
    sh:order 4;
    sh:path cs:code01
  ], [
    skos:example "A8";
    sh:datatype xsd:string;
    sh:description "It is assigned \"A\" for numbers, L for lowercase letters, and U for uppercase letters to make the first digit code of course of study item easier to handle in Excel filters and pivot tables."@en, "学習指導要領コードの1桁目をExcelのフィルタやピボットテーブルで扱いやすいように、数字であればAを、小文字であればLを、大文字であればUを付与したコード。"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Fcode Correspond to First Digit Code of Course of Study Item"@en, "学習指導要領コード1桁目に対応するFコード"@ja;
    sh:order 5;
    sh:path cs:fcode01
  ];
  sh:targetClass cs:Period.
