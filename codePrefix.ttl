@prefix cs: <https://w3id.org/jp-cos/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
cs:codePrefix
  rdf:type rdf:Property;
  rdfs:domain cs:Subject, cs:SubjectArea;
  rdfs:label "Code of Subject Area"@en, "教科コード"@ja;
  rdfs:range rdf:Literal.
cs:SubjectAreaShape sh:property [
    skos:example "821";
    sh:datatype xsd:string;
    sh:description "The first through third digits of the course of study code"@en, "学習指導要領コードの1桁目から3桁目。"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Code of Subject Area"@en, "教科コード"@ja;
    sh:order 9;
    sh:path cs:codePrefix
  ].
cs:SubjectShape sh:property [
    skos:example "83H1";
    sh:datatype xsd:string;
    sh:description "The first through 4th digits of the course of study code"@en, "学習指導要領コードの1桁目から4桁目。"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Code of Subject"@en, "科目コード"@ja;
    sh:order 9;
    sh:path cs:codePrefix
  ].
