@prefix cs: <https://w3id.org/jp-cos/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
cs:category
  rdf:type rdf:Property;
  rdfs:domain cs:Item;
  rdfs:label "Category"@en, "大項目"@ja;
  rdfs:range rdf:Literal.
cs:ItemShape sh:property [
    skos:example "目標及び内容（大項目）";
    sh:datatype xsd:string;
    sh:description "It corresponds to the 5th digit of the course of study code."@en, "学習指導要領コードの5桁目に対応"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Category"@en, "大項目"@ja;
    sh:order 11;
    sh:path cs:category
  ].
