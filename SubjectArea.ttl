cs:CosCommentaryShape sh:property [
    skos:example cs:Elementary\/2017\/社会;
    sh:class cs:SubjectArea;
    sh:minCount 1;
    sh:name "Subject Area"@en, "教科等"@ja;
    sh:order 3;
    sh:path cs:subjectArea
  ].
cs:CourseOfStudyShape sh:property [
    skos:example cs:Elementary\/2017\/国語;
    sh:class cs:SubjectArea;
    sh:minCount 1;
    sh:name "has a subject area"@en, "教科がある"@ja;
    sh:order 9;
    sh:path cs:hasSubjectArea
  ].
cs:ItemShape sh:property [
    skos:example cs:LowerSecondary\/2017\/外国語;
    sh:class cs:SubjectArea;
    sh:description "It corresponds to the 3rd digit of the course of study code."@en, "元データの「教科等」列の値。学習指導要領コードの3桁目に対応"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Subject Area"@en, "教科等"@ja;
    sh:order 7;
    sh:path cs:subjectArea
  ].
cs:RelatedSubjectAreaShape sh:property [
    skos:example cs:UpperSecondaryDeptSNES-Intellectual\/2019\/外国語;
    sh:class cs:SubjectArea;
    sh:name "Related"@en, "関係がある"@ja;
    sh:order 1;
    sh:path dct:relation
  ].
