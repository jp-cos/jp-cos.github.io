@prefix cs: <https://w3id.org/jp-cos/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix qb: <http://purl.org/linked-data/cube#>.
@prefix schema: <http://schema.org/>.
cs:SubjectShape
  rdf:type sh:NodeShape;
  sh:property [
    skos:example cs:LowerSecondary\/2017\/2017;
    sh:class cs:CourseOfStudyRevision;
    sh:description "Repeatable. It corresponds to the revisions of the course of study."@en, "複数の改正がある場合、改正の件数分、繰り返される。"@ja;
    sh:minCount 1;
    sh:name "Course Of Study Revision"@en, "学習指導要領（一部改正情報）"@ja;
    sh:order 1;
    sh:path cs:courseOfStudyRevision
  ], [
    skos:example "10";
    sh:datatype xsd:integer;
    sh:description "This is used in the order of the listings."@en, "表示順を決める場合などで利用"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Listing order of the course of study"@en, "学習指導要領掲載順"@ja;
    sh:order 2;
    sh:path qb:order
  ], [
    skos:example cs:Intellectual;
    sh:class cs:DisabilityCategory;
    sh:description "It corresponds to the second digit of the course of study code."@en, "学習指導要領コードの2桁目に対応"@ja;
    sh:name "Disability Category"@en, "障害分類"@ja;
    sh:order 3;
    sh:path cs:disabilityCategory
  ], [
    skos:example cs:school\/LowerSecondary;
    sh:class cs:School;
    sh:description "It corresponds to the second digit of the course of study code."@en, "学習指導要領コードの2桁目に対応"@ja;
    sh:maxCount 2;
    sh:minCount 1;
    sh:name "Type of School"@en, "学校種別"@ja;
    sh:order 4;
    sh:path cs:school
  ], [
    skos:example "<ul><li>\"英語\"@ja</li><li>\"えいご\"@ja-Hira</li><li>\"English\"@en</li></ul>";
    sh:datatype rdf:langString;
    sh:description "Using language tags, Japanese name, transcription of the name, and English name are shown. The meanings of language tags are as follows:  <dl><dt>@ja</dt><dd>Japanese name (Kanji)</dd><dt>@ja-Hira</dt><dd>Japanese name (Hiragana). The name of the subject area is transcribed in Hiragana.</dd><dt>@en</dt><dd>English name of the subject area</dd></dl>Note that English names are unfficial one. Translation is done by the maintainers of this dataset. While we could not find the official English translations for the subject area, we refer to the tentative translations in the curriculum guidelines, and the English guide entitled \"Education in Japan\" published by the MEXT."@en, "言語コードを用いて、教科名に加え、そのよみ、英語名称を示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>日本語名称（漢字表記）</dd><dt>@ja-Hira</dt><dd>日本語名称（ひらがな表記）。教科名のよみをひらがな表記で示します。</dd><dt>@en</dt><dd>教科名の英語名称</dd></dl>注意：英訳名称は、文部科学省の正式なものではありません。翻訳の責任は、江草、高久にあります。 理由：大半の教科については、文部科学省が発表している正式な英語訳を見つけられませんでした（教育図書館へのレファレンス調査も実施済み）。 なお、学習指導要領の英訳（仮訳） （小学校、 中学校、 高等学校） に記載されている教科はそれらに由来するものです。 また、小学校、中学校の教科については、文部科学省が出している英語ガイド（Education In JAPAN, 13版）67ページの記載も参考にしました。 いずれにも記載のない教科名は、江草・高久によって一から英訳したものです。"@ja;
    sh:languageIn [
      rdf:first "ja";
      rdf:rest [
        rdf:first "ja-Hira";
        rdf:rest [
          rdf:first "en";
          rdf:rest rdf:nil
        ]
      ]
    ];
    sh:maxCount 3;
    sh:minCount 1;
    sh:name "Subject Name"@en, "科目名"@ja;
    sh:order 5;
    sh:path schema:name;
    sh:uniqueLang true
  ], [
    skos:example cs:source\/Elementary-2008;
    sh:class cs:SourceOfEnglishName;
    sh:description "To provide the source information that serves as the basis for the English notation."@en, "英語表記の根拠となる出典情報を表す。"@ja;
    sh:maxCount 1;
    sh:name "Source for the English name"@en, "英語表記出典"@ja;
    sh:order 6;
    sh:path cs:sourceOfEnglishName
  ], [
    skos:example "1";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "4th Digit Code of Course of Study Item"@en, "学習指導要領コード4桁目"@ja;
    sh:order 7;
    sh:path cs:code04
  ], [
    skos:example "A1";
    sh:datatype xsd:string;
    sh:description "It is assigned \"A\" for numbers, L for lowercase letters, and U for uppercase letters to make the 4th digit code of course of study item easier to handle in Excel filters and pivot tables."@en, "学習指導要領コードの4桁目をExcelのフィルタやピボットテーブルで扱いやすいように、数字であればAを、小文字であればLを、大文字であればUを付与したコード。"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Fcode Correspond to 4th Digit Code of Course of Study Item"@en, "学習指導要領コード4桁目に対応するFコード"@ja;
    sh:order 8;
    sh:path cs:fcode04
  ], [
    skos:example "83H1";
    sh:datatype xsd:string;
    sh:description "The first through 4th digits of the course of study code"@en, "学習指導要領コードの1桁目から4桁目。"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Code of Subject"@en, "科目コード"@ja;
    sh:order 9;
    sh:path cs:codePrefix
  ], [
    skos:example "A8A3UHA1";
    sh:datatype xsd:string;
    sh:description "It is assigned \"A\" for numbers, L for lowercase letters, and U for uppercase letters to make from the first digit code to the 4th one of course of study item easier to handle in Excel filters and pivot tables."@en, "学習指導要領コードの1桁目から4桁目をExcelのフィルタやピボットテーブルで扱いやすいように、数字であればAを、小文字であればLを、大文字であればUを付与したコード。"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Fcode of Subject"@en, "F科目コード"@ja;
    sh:order 10;
    sh:path cs:fcodePrefix
  ];
  sh:targetClass cs:Subject.
