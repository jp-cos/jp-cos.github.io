@prefix cs: <https://w3id.org/jp-cos/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
cs:School
  rdf:type rdfs:Class;
  rdfs:comment "It represents school class.URIs for the resources are represented as the following forms:<br><code>https://w3id.org/jp-cos/school/school/<var>type of schools</var></code>"@en, "学校を表すクラス。このリソースは次のようなURIにより表現されます。<br><code>https://w3id.org/jp-cos/school/school/<var>学校種別</var></code>"@ja;
  rdfs:label "Type of School"@en, "学校種別"@ja.
cs:school\/Kindergarten rdf:type cs:School.
cs:school\/UpperSecondary rdf:type cs:School.
cs:school\/KindergartenDeptSNES rdf:type cs:School.
cs:school\/LowerSecondaryDeptSNES rdf:type cs:School.
cs:school\/UpperSecondaryDeptSNES rdf:type cs:School.
cs:school\/SNES rdf:type cs:School.
cs:CosCommentaryShape sh:property [
    skos:example cs:Elementary;
    sh:class cs:School;
    sh:maxCount 2;
    sh:minCount 1;
    sh:name "Type of School"@en, "学校種別"@ja;
    sh:order 2;
    sh:path cs:school
  ].
cs:CourseOfStudyRevisionShape sh:property [
    skos:example cs:school\/Elementary;
    sh:class cs:School;
    sh:description "It corresponds to the second digit of the course of study code."@en, "学習指導要領コードの2桁目に対応"@ja;
    sh:maxCount 2;
    sh:minCount 1;
    sh:name "Type of School"@en, "学校種別"@ja;
    sh:order 12;
    sh:path cs:school
  ].
cs:CourseOfStudyShape sh:property [
    skos:example cs:school\/Elementary;
    sh:class cs:School;
    sh:description "It corresponds to the second digit of the course of study code."@en, "学習指導要領コードの2桁目に対応"@ja;
    sh:maxCount 2;
    sh:minCount 1;
    sh:name "Type of School"@en, "学校種別"@ja;
    sh:order 5;
    sh:path cs:school
  ].
cs:DatasetShape sh:property [
    skos:example cs:school\/Elementary;
    sh:class cs:School;
    sh:description "It corresponds to the second digit of the course of study code."@en, "学習指導要領コードの2桁目に対応"@ja;
    sh:maxCount 2;
    sh:minCount 1;
    sh:name "Type of School"@en, "学校種別"@ja;
    sh:order 4;
    sh:path cs:school
  ].
cs:ItemShape sh:property [
    skos:example <cs:school/LowerSecondary>;
    sh:class cs:School;
    sh:description "It corresponds to the second digit of the course of study code."@en, "学習指導要領コードの2桁目に対応"@ja;
    sh:maxCount 2;
    sh:minCount 1;
    sh:name "Type of School"@en, "学校種別"@ja;
    sh:order 5;
    sh:path cs:school
  ].
cs:SchoolShape sh:targetClass cs:School.
cs:StageShape sh:property [
    skos:example cs:school\/ElementaryDeptSNES;
    sh:class cs:School;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Type of School"@en, "学校種別"@ja;
    sh:order 6;
    sh:path cs:school
  ].
cs:SubjectAreaShape sh:property [
    skos:example cs:school\/LowerSecondary;
    sh:class cs:School;
    sh:description "It corresponds to the second digit of the course of study code."@en, "学習指導要領コードの2桁目に対応"@ja;
    sh:maxCount 2;
    sh:minCount 1;
    sh:name "Type of School"@en, "学校種別"@ja;
    sh:order 4;
    sh:path cs:school
  ].
cs:SubjectShape sh:property [
    skos:example cs:school\/LowerSecondary;
    sh:class cs:School;
    sh:description "It corresponds to the second digit of the course of study code."@en, "学習指導要領コードの2桁目に対応"@ja;
    sh:maxCount 2;
    sh:minCount 1;
    sh:name "Type of School"@en, "学校種別"@ja;
    sh:order 4;
    sh:path cs:school
  ].
